# Hardware config for benchbot (loaded by arm.py; shell env vars override these).
# Ports taken from the working lerobot-teleoperate run on 2026-10-03.
# Confirm after plugging in:  ls /dev/tty.usbmodem*
FOLLOWER_PORT=/dev/tty.usbmodem5B415321481
LEADER_PORT=/dev/tty.usbmodem5B415332561
# Must match the ids used with lerobot-calibrate
# (~/.cache/huggingface/lerobot/calibration/{robots/so_follower,teleoperators/so_leader}/)
FOLLOWER_ID=follower_so101
LEADER_ID=leader_so101
# Keep the follower holding its pose when a script exits (set true to go limp)
DISABLE_TORQUE_ON_DISCONNECT=false
