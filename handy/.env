# Hardware config for Handy (loaded by arm.py; shell env vars override these).
# Ports need no editing: each controller board is recognised by its USB serial (arms.json).
# `python arm.py` lists what is connected (arm, role, calibration id, port).
#
# Arms, in order. Names are labels only ("right"/"left" is a convention, pick what matches
# the bench). The FIRST arm is where the old single-arm skills (unprefixed keys) play, and the
# default for wristrec / adjust / visual_servoing, so keep the original pair (wrist camera) first.
ARMS=right,left

# Each arm's calibration ids: must match the ids used with lerobot-calibrate
# (~/.cache/huggingface/lerobot/calibration/{robots/so_follower,teleoperators/so_leader}/).
# A script refuses to drive a different arm than the one named here.
# *_PORT is only a fallback for a board that can't be identified (motors that lost their calibration).

# ---- right: the original pair
RIGHT_FOLLOWER_ID=follower_so101
RIGHT_LEADER_ID=leader_so101
RIGHT_FOLLOWER_PORT=/dev/tty.usbmodem5B415321481
RIGHT_LEADER_PORT=/dev/tty.usbmodem5B415332561

# ---- left: the second pair. Calibrate once with these ids:
#   lerobot-calibrate --robot.type=so101_follower --robot.port=$LEFT_FOLLOWER_PORT --robot.id=follower_so101_left
#   lerobot-calibrate --teleop.type=so101_leader  --teleop.port=$LEFT_LEADER_PORT  --teleop.id=leader_so101_left
LEFT_FOLLOWER_ID=follower_so101_left
LEFT_LEADER_ID=leader_so101_left
LEFT_FOLLOWER_PORT=/dev/tty.usbmodem5B421342051
LEFT_LEADER_PORT=/dev/tty.usbmodem5B421338871

# Keep the followers holding their pose when a script exits (set true to go limp)
DISABLE_TORQUE_ON_DISCONNECT=false
# Grippers are never commanded below this (0=closed..100=open); protects the servo from overload
GRIPPER_MIN=3
# Voice for spoken replies (macOS `say -v`). Download a Premium voice in System Settings > Accessibility >
# Spoken Content > System Voice > Manage Voices, then e.g. TTS_VOICE=Ava. Empty = system default.
TTS_VOICE=Ava

# Wrist camera's OpenCV index (find it with `python wristrec.py --probe`); used by wristrec and visual_servoing
WRIST_CAMERA=0
